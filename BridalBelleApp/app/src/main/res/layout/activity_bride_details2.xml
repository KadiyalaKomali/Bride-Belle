<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    android:orientation="vertical"
    android:background="@drawable/mrs"
    tools:context=".activity.BrideDetailsActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bridal Wear"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bridal Lehengas"
                android:onClick="openBrideDetails"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kanjeevaram Sarees"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frocks"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trousseau Sarees"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Narayana Pattu"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />




        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mehendi"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arabic"
                android:layout_margin="10dp"
                android:onClick="openMehandhi"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indian"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Western"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moroccan"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Floral"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />




        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jewellery"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bridal Jewellery"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flower Jewellery"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kundan Jewellery"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diamond Jewellery"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plantinum Jewellery"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />




        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Footwear "
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Heels"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flats"
                android:layout_margin="10dp"
                android:textColor="#000"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sandals"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wedges"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ballerians"
                android:layout_margin="10dp"
                android:textColor="#9CE91E63"
                android:textSize="20sp" />




        </LinearLayout>

    </LinearLayout>
</ScrollView>